generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionStatus {
  COMPLETED
  RECEIVABLE
  PAYABLE
  PARTIAL
  IN_PROGRESS
  OVERDUE
  CANCELLED
}

enum TransactionExecutionStatus {
  COMPLETED
  PENDING
  NOT_EXECUTED
}

enum NotExecutedAction {
  REFUND
  CONVERT_TO_WALLET
  KEEP_WITH_NOTE
}

enum MovementType {
  CASH_IN
  CASH_OUT
  RECEIVABLE
  PAYABLE
  SETTLE_RECEIVABLE
  SETTLE_PAYABLE
  NO_CASH_EFFECT
  REVERSAL
  CANCELLATION
}

enum CashDirection {
  IN
  OUT
  NONE
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
}

enum CustomerCategory {
  VIP
  REGULAR
}

enum SheinCardStatus {
  AVAILABLE
  SOLD
  USED
  RESERVED
  INVALID
  CANCELLED
}

enum SheinCardLogType {
  PURCHASE
  SALE
  RESERVE
  RELEASE
  CANCEL
  UPDATE
}

enum ReceivedCardStatus {
  RECEIVED
  IN_SETTLEMENT
  SETTLED
  PARTIAL
  COMPLETED
  CANCELLED
}

enum SheinPaymentMethod {
  LYD_CASH
  USD_CASH
  LYD_TRANSFER
  LYD_OFFICE_TRANSFER
  LYD_CARD
  USD_TRANSFER
  USD_CARD
  CARD
}

enum CustomerWalletAccountType {
  CREDIT
  DEBT
}

enum CustomerWalletSettlementDirection {
  ADD
  SUBTRACT
}

enum CustomerCardOperationType {
  GIFT_CARD
  INVOICE
  FINAL_SETTLEMENT
  REJECT
  REACTIVATE
  ADJUSTMENT
}

enum CustomerCardEntryStatus {
  COMPLETED
  CANCELLED
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     LoginSession[]
  attempts     LoginAttempt[]
  auditLogs    AuditLog[]
  walletSettlements CustomerWalletSettlement[]
  executedExecutionItems TransactionExecutionItem[] @relation("TransactionExecutionItemExecutor")

  @@index([isActive])
  @@map("Users")
}

model Person {
  id           String                 @id @default(cuid())
  customerNo   String?
  fullName     String
  phone        String?
  address      String?
  externalId   String?
  notes        String?
  category     CustomerCategory       @default(REGULAR)
  status       EntityStatus           @default(ACTIVE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deletedAt    DateTime?
  transactions FinancialTransaction[]
  sheinSales   SheinCard[]            @relation("SheinCardBuyer")
  sheinCardSales SheinCardSale[]
  cardBatches  ReceivedCardBatch[]
  cardEntryTransactions CustomerCardEntryTransaction[]
  cardDeliveries CustomerCardDelivery[]
  accountRepayments CustomerAccountRepayment[]
  cashboxMovements CashboxMovement[]   @relation("CashboxMovementPerson")
  walletSettlements CustomerWalletSettlement[]
  transactionExecutionItems TransactionExecutionItem[] @relation("TransactionExecutionItemCustomer")

  @@index([fullName])
  @@index([phone])
  @@index([customerNo])
  @@index([category])
  @@index([createdAt])
  @@index([status, deletedAt])
}

model Currency {
  id               String                 @id @default(cuid())
  code             String                 @unique
  name             String
  symbol           String
  decimals         Int                    @default(2)
  isActive         Boolean                @default(true)
  isDefault        Boolean                @default(false)
  createdAt        DateTime               @default(now())
  transactions     FinancialTransaction[]
  movements        TransactionMovement[]
  cashboxMovements CashboxMovement[]
  receivedBatches  ReceivedCardBatch[]
  cardEntryTransactions CustomerCardEntryTransaction[]
  customerCardDeliveries CustomerCardDelivery[]
  accountRepayments CustomerAccountRepayment[]
  receivedCardSettlements ReceivedCustomerCard[] @relation("ReceivedCardSettlementCurrency")
  sheinCardSales   SheinCard[]            @relation("SheinCardSaleCurrency")
  sheinSalesReports SheinCardSale[]
  conversionSources CurrencyConversion[]   @relation("CurrencyConversionSource")
  conversionTargets CurrencyConversion[]   @relation("CurrencyConversionTarget")
  walletSettlements CustomerWalletSettlement[]

  @@index([createdAt])
  @@index([isActive])
}

model TransactionType {
  id           String                 @id @default(cuid())
  name         String                 @unique
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  transactions FinancialTransaction[]

  @@index([createdAt])
}

model FinancialTransaction {
  id                   String                @id @default(cuid())
  number               String                @unique
  personId             String?
  typeId               String?
  customType           String?
  description          String?
  executionType        String?
  operationKind        String?
  operationDetails     Json?
  currencyId           String
  agreedAmount         Decimal               @db.Decimal(20, 6)
  receivedAmount       Decimal               @default(0) @db.Decimal(20, 6)
  paidAmount           Decimal               @default(0) @db.Decimal(20, 6)
  receivableAmount     Decimal               @default(0) @db.Decimal(20, 6)
  payableAmount        Decimal               @default(0) @db.Decimal(20, 6)
  exchangeRate         Decimal?              @db.Decimal(20, 8)
  transactionAt        DateTime              @default(now())
  dueAt                DateTime?
  txId                 String?
  cardNumber           String?
  bankName             String?
  sheinPaymentMethod   SheinPaymentMethod?
  verificationReceived Boolean               @default(false)
  secureInternalNote   String?
  notes                String?
  executionStatus      TransactionExecutionStatus @default(COMPLETED)
  executionNote        String?
  notExecutedAction    NotExecutedAction?
  status               TransactionStatus     @default(IN_PROGRESS)
  statusOverride       Boolean               @default(false)
  createdBy            String                @default("system")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  person               Person?               @relation(fields: [personId], references: [id])
  type                 TransactionType?      @relation(fields: [typeId], references: [id])
  currency             Currency              @relation(fields: [currencyId], references: [id])
  movements            TransactionMovement[]
  cashboxMovements     CashboxMovement[]
  attachments          Attachment[]
  sheinCardSale        SheinCardSale?
  executionItems       TransactionExecutionItem[]

  @@index([transactionAt])
  @@index([createdAt])
  @@index([status])
  @@index([executionStatus])
  @@index([personId])
  @@index([typeId])
  @@index([currencyId])
  @@index([operationKind])
  @@index([txId])
  @@index([cardNumber])
  @@index([bankName])
}

model TransactionMovement {
  id                 String               @id @default(cuid())
  transactionId      String
  type               MovementType
  direction          CashDirection
  amount             Decimal              @db.Decimal(20, 6)
  currencyId         String
  occurredAt         DateTime             @default(now())
  notes              String?
  createdBy          String               @default("system")
  balanceBefore      Decimal              @db.Decimal(20, 6)
  balanceAfter       Decimal              @db.Decimal(20, 6)
  reversedMovementId String?
  createdAt          DateTime             @default(now())
  deletedAt          DateTime?
  transaction        FinancialTransaction @relation(fields: [transactionId], references: [id])
  currency           Currency             @relation(fields: [currencyId], references: [id])
  attachments        Attachment[]

  @@index([occurredAt])
  @@index([createdAt])
  @@index([transactionId])
  @@index([currencyId])
  @@index([type])
}

model CashboxMovement {
  id            String                @id @default(cuid())
  currencyId    String
  transactionId String?
  personId      String?
  direction     CashDirection
  amount        Decimal               @db.Decimal(20, 6)
  paymentMethod String?
  reason        String
  sourceType    String?
  sourceId      String?
  note          String?
  occurredAt    DateTime              @default(now())
  balanceBefore Decimal               @db.Decimal(20, 6)
  balanceAfter  Decimal               @db.Decimal(20, 6)
  createdBy     String                @default("system")
  reversedMovementId String?
  createdAt     DateTime              @default(now())
  currency      Currency              @relation(fields: [currencyId], references: [id])
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id])
  person        Person?               @relation("CashboxMovementPerson", fields: [personId], references: [id])

  @@index([occurredAt])
  @@index([createdAt])
  @@index([currencyId])
  @@index([transactionId])
  @@index([personId])
  @@index([paymentMethod])
  @@index([sourceType, sourceId])
}

model Attachment {
  id            String                @id @default(cuid())
  transactionId String?
  movementId    String?
  originalName  String
  storageKey    String
  mimeType      String
  size          Int
  createdAt     DateTime              @default(now())
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id])
  movement      TransactionMovement?  @relation(fields: [movementId], references: [id])
}

model LoginSession {
  id             String    @id
  userId         String?
  username       String?
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  ip             String?
  userAgent      String?
  revokedAt      DateTime?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([username])
}

model LoginAttempt {
  id          String   @id @default(cuid())
  userId      String?
  username    String?
  ip          String?
  userAgent   String?
  success     Boolean
  attemptedAt DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ip, attemptedAt])
  @@index([userId])
  @@index([username])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  username    String?
  action      String
  entityType  String?
  entityId    String?
  oldValue    Json?
  newValue    Json?
  description String?
  ip          String?
  userAgent   String?
  sessionId   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([username])
}

model CustomerWalletSettlement {
  id            String                            @id @default(cuid())
  personId      String
  currencyId    String
  paymentMethod String
  accountType   CustomerWalletAccountType
  direction     CustomerWalletSettlementDirection
  amount        Decimal                           @db.Decimal(20, 6)
  balanceBefore Decimal                           @db.Decimal(20, 6)
  balanceAfter  Decimal                           @db.Decimal(20, 6)
  reason        String
  note          String?
  userId        String?
  username      String?
  occurredAt    DateTime                          @default(now())
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @default(now()) @updatedAt
  deletedAt     DateTime?
  deletedBy     String?
  deleteReason  String?
  movementKind  String                            @default("ADJUSTMENT")
  linkedSettlementId String?
  settlementMethod String?
  person        Person                            @relation(fields: [personId], references: [id])
  currency      Currency                          @relation(fields: [currencyId], references: [id])
  user          User?                             @relation(fields: [userId], references: [id], onDelete: SetNull)
  accountRepayment CustomerAccountRepayment?

  @@index([personId])
  @@index([currencyId])
  @@index([paymentMethod])
  @@index([accountType])
  @@index([movementKind])
  @@index([linkedSettlementId])
  @@index([occurredAt])
  @@index([createdAt])
  @@index([userId])
  @@index([username])
  @@index([deletedAt])
}

model TransactionExecutionItem {
  id               String                     @id @default(cuid())
  transactionId    String
  customerId       String?
  itemNumber       String
  status           TransactionExecutionStatus @default(PENDING)
  sheinCardId      String?                    @unique
  executedAt       DateTime?
  executedByUserId String?
  note             String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  transaction      FinancialTransaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customer         Person?                    @relation("TransactionExecutionItemCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  sheinCard        SheinCard?                 @relation("TransactionExecutionItemSheinCard", fields: [sheinCardId], references: [id], onDelete: SetNull)
  executedBy       User?                      @relation("TransactionExecutionItemExecutor", fields: [executedByUserId], references: [id], onDelete: SetNull)

  @@unique([transactionId, itemNumber])
  @@index([transactionId])
  @@index([customerId])
  @@index([status])
  @@index([executedByUserId])
  @@index([createdAt])
}

model DeletedItem {
  id         String    @id @default(cuid())
  entityType String
  entityId   String
  snapshot   Json
  deletedAt  DateTime  @default(now())
  restoredAt DateTime?
}

model BackupRecord {
  id        String   @id @default(cuid())
  type      String
  filename  String
  status    String
  createdAt DateTime @default(now())
}

model SheinCard {
  id                String          @id @default(cuid())
  code              String          @unique
  cardCodeEncrypted String?
  pinEncrypted      String?
  denomination      Decimal         @db.Decimal(20, 6)
  status            SheinCardStatus @default(AVAILABLE)
  purchasePrice     Decimal?        @db.Decimal(20, 6)
  salePrice         Decimal?        @db.Decimal(20, 6)
  saleCurrencyId    String?
  saleCashboxMovementId String?
  salePaymentMethod SheinPaymentMethod?
  linkedTransactionId String?
  linkedExecutionItemId String? @unique
  usedAt            DateTime?
  usedByUserId      String?
  saleCurrency      Currency?       @relation("SheinCardSaleCurrency", fields: [saleCurrencyId], references: [id])
  supplier          String?
  buyerPersonId     String?
  buyer             Person?         @relation("SheinCardBuyer", fields: [buyerPersonId], references: [id])
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  soldAt            DateTime?
  logs              SheinCardLog[]
  saleItems         SheinCardSaleItem?
  executionItemRefs TransactionExecutionItem[] @relation("TransactionExecutionItemSheinCard")

  @@index([denomination])
  @@index([status])
  @@index([createdAt])
  @@index([buyerPersonId])
  @@index([saleCurrencyId])
  @@index([linkedTransactionId])
  @@index([usedByUserId])
}

model SheinCardSale {
  id             String             @id @default(cuid())
  transactionId  String?            @unique
  personId       String?
  currencyId     String
  paymentMethod  SheinPaymentMethod
  denomination   Decimal            @db.Decimal(20, 6)
  cardCount      Int
  pricePerCard   Decimal            @db.Decimal(20, 6)
  totalAmount    Decimal            @db.Decimal(20, 6)
  occurredAt     DateTime           @default(now())
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  transaction    FinancialTransaction? @relation(fields: [transactionId], references: [id])
  person         Person?            @relation(fields: [personId], references: [id])
  currency       Currency           @relation(fields: [currencyId], references: [id])
  items          SheinCardSaleItem[]

  @@index([occurredAt])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([denomination])
  @@index([personId])
  @@index([currencyId])
}

model SheinCardSaleItem {
  id        String        @id @default(cuid())
  saleId    String
  cardId    String       @unique
  createdAt DateTime     @default(now())
  sale      SheinCardSale @relation(fields: [saleId], references: [id])
  card      SheinCard     @relation(fields: [cardId], references: [id])

  @@index([saleId])
}

model SheinCardLog {
  id        String           @id @default(cuid())
  cardId    String
  type      SheinCardLogType
  amount    Decimal?         @db.Decimal(20, 6)
  note      String?
  createdBy String           @default("system")
  createdAt DateTime         @default(now())
  card      SheinCard        @relation(fields: [cardId], references: [id])

  @@index([cardId])
  @@index([createdAt])
}

model ReceivedCardBatch {
  id                  String                 @id @default(cuid())
  personId            String
  currencyId          String?
  entryTransactionId  String?                @unique
  receivedAt          DateTime               @default(now())
  cardCount           Int
  agreedAmountPerCard Decimal                @db.Decimal(20, 6)
  totalOriginalAmount Decimal                @default(0) @db.Decimal(20, 6)
  totalAgreedAmount   Decimal                @default(0) @db.Decimal(20, 6)
  notes               String?
  createdByUserId     String?
  createdByUsername   String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  person              Person                 @relation(fields: [personId], references: [id])
  currency            Currency?              @relation(fields: [currencyId], references: [id])
  entryTransaction    CustomerCardEntryTransaction? @relation(fields: [entryTransactionId], references: [id], onDelete: SetNull)
  cards               ReceivedCustomerCard[]

  @@index([personId])
  @@index([entryTransactionId])
  @@index([receivedAt])
  @@index([createdAt])
}

model ReceivedCustomerCard {
  id                   String             @id @default(cuid())
  batchId              String
  sequence             Int
  publicCode           String?            @unique
  bankName             String?
  cardLast4            String?
  valueUsd             Decimal            @default(0) @db.Decimal(20, 6)
  agreedAmount         Decimal            @db.Decimal(20, 6)
  settlementCurrencyId String?
  settlementAmount     Decimal?           @db.Decimal(20, 6)
  settlementPaymentMethod SheinPaymentMethod?
  receivedAmount       Decimal            @default(0) @db.Decimal(20, 6)
  status               ReceivedCardStatus @default(RECEIVED)
  verificationReceived Boolean            @default(false)
  receivedCashboxMovementId String?
  settlementCashboxMovementId String?
  secureInternalNote   String?
  notes                String?
  totalDeducted        Decimal            @default(0) @db.Decimal(20, 6)
  remainingAmount      Decimal            @default(0) @db.Decimal(20, 6)
  progressPercent      Decimal            @default(0) @db.Decimal(20, 6)
  currentStage         Int                @default(0)
  rejectedAt           DateTime?
  rejectReason         String?
  cardImageDataUrl     String?            @db.Text
  cardThumbnailDataUrl String?            @db.Text
  cardImageMimeType    String?
  cardImageSize        Int?
  cardImageUpdatedAt   DateTime?
  archivedAt           DateTime?
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  batch                ReceivedCardBatch  @relation(fields: [batchId], references: [id])
  settlementCurrency   Currency?          @relation("ReceivedCardSettlementCurrency", fields: [settlementCurrencyId], references: [id])
  stageLogs            ReceivedCardStageLog[]
  operations           ReceivedCardOperation[]

  @@unique([batchId, sequence])
  @@index([publicCode])
  @@index([status])
  @@index([cardLast4])
  @@index([remainingAmount])
  @@index([rejectedAt])
  @@index([currentStage])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([batchId])
  @@index([settlementCurrencyId])
  @@index([settlementPaymentMethod])
}

model ReceivedCardStageLog {
  id        String               @id @default(cuid())
  cardId    String
  stage     Int
  direction String
  amount    Decimal              @default(0) @db.Decimal(20, 6)
  note      String?
  userId    String?
  username  String?
  createdAt DateTime             @default(now())
  card      ReceivedCustomerCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([stage])
  @@index([createdAt])
}

model CustomerCardEntryTransaction {
  id                  String                  @id @default(cuid())
  personId            String
  currencyId          String?
  status              CustomerCardEntryStatus @default(COMPLETED)
  cardCount           Int
  totalOriginalAmount Decimal                 @default(0) @db.Decimal(20, 6)
  totalAgreedAmount   Decimal                 @default(0) @db.Decimal(20, 6)
  duplicateWarnings   Json?
  notes               String?
  userId              String?
  username            String?
  occurredAt          DateTime                @default(now())
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  person              Person                  @relation(fields: [personId], references: [id])
  currency            Currency?               @relation(fields: [currencyId], references: [id])
  batch               ReceivedCardBatch?

  @@index([personId])
  @@index([currencyId])
  @@index([status])
  @@index([occurredAt])
  @@index([createdAt])
  @@index([userId])
  @@index([username])
}

model CardDiscountCategory {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  faceValue       Decimal  @db.Decimal(20, 6)
  deductionAmount Decimal  @db.Decimal(20, 6)
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([isDefault])
  @@index([createdAt])
}

model ReceivedCardOperation {
  id              String                    @id @default(cuid())
  cardId          String
  operationType   CustomerCardOperationType
  categoryCode    String?
  categoryFaceValue Decimal?                @db.Decimal(20, 6)
  quantity        Int                       @default(1)
  amount          Decimal                   @default(0) @db.Decimal(20, 6)
  balanceBefore   Decimal                   @default(0) @db.Decimal(20, 6)
  balanceAfter    Decimal                   @default(0) @db.Decimal(20, 6)
  progressBefore  Decimal                   @default(0) @db.Decimal(20, 6)
  progressAfter   Decimal                   @default(0) @db.Decimal(20, 6)
  note            String?
  reason          String?
  userId          String?
  username        String?
  occurredAt      DateTime                  @default(now())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  deletedAt       DateTime?
  deletedBy       String?
  deleteReason    String?
  card            ReceivedCustomerCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([operationType])
  @@index([occurredAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([userId])
  @@index([username])
}

model CustomerCardDelivery {
  id            String   @id @default(cuid())
  personId      String
  currencyId    String
  paymentMethod String?
  amount        Decimal  @db.Decimal(20, 6)
  balanceBefore Decimal  @db.Decimal(20, 6)
  balanceAfter  Decimal  @db.Decimal(20, 6)
  reason        String   @default("CUSTOMER_CARD_DELIVERY")
  note          String?
  userId        String?
  username      String?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  deletedBy     String?
  deleteReason  String?
  person        Person   @relation(fields: [personId], references: [id])
  currency      Currency @relation(fields: [currencyId], references: [id])

  @@index([personId])
  @@index([currencyId])
  @@index([paymentMethod])
  @@index([occurredAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([userId])
  @@index([username])
}

model CustomerAccountRepayment {
  id            String                    @id @default(cuid())
  settlementId  String                    @unique
  personId      String
  currencyId    String
  paymentMethod String
  accountType   CustomerWalletAccountType
  amount        Decimal                   @db.Decimal(20, 6)
  balanceBefore Decimal                   @db.Decimal(20, 6)
  balanceAfter  Decimal                   @db.Decimal(20, 6)
  reason        String
  note          String?
  userId        String?
  username      String?
  occurredAt    DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  deletedAt     DateTime?
  deletedBy     String?
  deleteReason  String?
  person        Person                    @relation(fields: [personId], references: [id])
  currency      Currency                  @relation(fields: [currencyId], references: [id])
  settlement    CustomerWalletSettlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([currencyId])
  @@index([paymentMethod])
  @@index([accountType])
  @@index([occurredAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([userId])
  @@index([username])
}

model CurrencyConversion {
  id             String   @id @default(cuid())
  fromCurrencyId String
  toCurrencyId   String
  fromAmount     Decimal  @db.Decimal(20, 6)
  toAmount       Decimal  @db.Decimal(20, 6)
  exchangeRate   Decimal  @db.Decimal(20, 8)
  operatorName   String
  notes          String?
  occurredAt     DateTime @default(now())
  fromMovementId String?
  toMovementId   String?
  createdAt      DateTime @default(now())
  fromCurrency   Currency @relation("CurrencyConversionSource", fields: [fromCurrencyId], references: [id])
  toCurrency     Currency @relation("CurrencyConversionTarget", fields: [toCurrencyId], references: [id])

  @@index([occurredAt])
  @@index([createdAt])
  @@index([fromCurrencyId])
  @@index([toCurrencyId])
}
